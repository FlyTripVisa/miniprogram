{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miniprogram",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "Browser" },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "flytripvisa-db",
      "database_id": "f274effd-ff6e-4c75-b8a8-4083726232fe",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "flytripvisa" }
  ],
  "version_metadata": { "binding": "metadata" }
}
