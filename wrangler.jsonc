{
	"name": "miniprogram",
	"main": "src/server.ts",
	// Set this to today's date
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	"ai": { "binding": "AI" },
	"durable_objects": {
		"bindings": [{ "name": "miniprogram", "class_name": "ChatAgent" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["miniprogram"] }],
}